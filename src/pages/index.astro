---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seasons } from '../data/seasons';

const base = import.meta.env.BASE_URL;
const sections = [
  { title: 'Projects', href: `${base}projects/` },
  { title: 'About', href: `${base}about/` },
  { title: 'Resume', href: `${base}resume/` },
];
---

<BaseLayout>
  <div class="home">
    <section class="home-hero container">
      <div class="home-hero__space" aria-hidden="true"></div>

      <div class="home-hero__center">
        <div class="portrait-placeholder" role="img" aria-label="Place a portrait here">Picture</div>

        <div class="home-intro">
          <p>Hello, I'm <strong>Damian Rodko</strong>.</p>
          <p>
            I'm a rising senior at Forest Hills High School in New York City and the lead engineer for my high school's competitive robotics team. I'm interested in pursuing mechanical engineering.
          </p>
        </div>
      </div>

      <div class="social-links">
        <p>Links</p>
        <a href="https://github.com/DamianRodko" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/damian-rodko-537459412/" rel="noreferrer">LinkedIn</a>
      </div>
    </section>

    <section class="profile-grid container">
      <article class="profile-block">
        <h2>Skills & interests</h2>
        <ul>
          <li>Embedded systems</li>
          <li>CAD & 3D printing</li>
          <li>Mechanical engineering</li>
        </ul>
      </article>

      <article class="profile-block">
        <h2>Achievements & activities</h2>
        <ul>
          <li>Lead engineer</li>
          <li>Competitive robotics</li>
          <li>Engineering projects</li>
          <li>Wrestling</li>
          <li>Programming</li>
        </ul>
      </article>

      <article class="profile-block">
        <h2>Goals & education</h2>
        <ul>
          <li>Forest Hills High School</li>
        </ul>
      </article>
    </section>

    <section class="page-links container" aria-label="Pages">
      {
        sections.map((section) => (
          <a href={section.href}>
            {section.title}
          </a>
        ))
      }
    </section>

    <section class="seasons-section section section--tight" id="ftc-seasons">
      <div class="container">
        <h2>FTC Seasons</h2>
        <div class="seasons-grid">
          {
            seasons.map((season) => (
              <a class="project-card season-card" href={`${base}seasons/${season.slug}/`}>
                <h2>{season.title}</h2>
                <p>{season.status}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
